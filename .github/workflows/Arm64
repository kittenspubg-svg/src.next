name: Orbit Browser Build (ARM64)

on:
  workflow_dispatch:
  push:
    branches:
      - upgrade/chromium-130
    tags:
      - 'v*'

jobs:
  build-arm64:
    name: Build ARM64 APK
    runs-on: ubuntu-latest
    timeout-minutes: 360

    env:
      CHROMIUM_OUT_DIR: out/Orbit
      ANDROID_HOME: ${{ github.workspace }}/android-sdk
      ANDROID_SDK_ROOT: ${{ github.workspace }}/android-sdk

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Java 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "17"

      - name: Install deps
        run: |
          sudo apt-get update
          sudo apt-get install -y \
            build-essential git python3 python3-pip pkg-config \
            ca-certificates unzip zip curl ninja-build \
            libgtk-3-0 libx11-dev libxrandr-dev libxss-dev \
            libasound2-dev libnss3-dev libxtst-dev libdrm-dev

      - name: Setup depot_tools
        run: |
          git clone https://chromium.googlesource.com/chromium/tools/depot_tools.git /tmp/depot_tools
          echo "/tmp/depot_tools" >> "$GITHUB_PATH"

      - name: Setup Android SDK
        run: |
          mkdir -p "$ANDROID_HOME"

      - name: Generate GN config (ARM64)
        run: |
          mkdir -p "$CHROMIUM_OUT_DIR"
          gn gen "$CHROMIUM_OUT_DIR" --args='
            target_os="android"
            target_cpu="arm64"
            is_debug=false
            is_component_build=false
            use_official_google_api_keys=false
            enable_nacl=false
          '

      - name: Build ARM64 APK
        run: |
          autoninja -C "$CHROMIUM_OUT_DIR" chrome_public_apk

      - name: Find APK
        run: |
          find "$CHROMIUM_OUT_DIR" -type f -name "*.apk" -exec ls -lh {} \;

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: OrbitBrowser-arm64
          path: out/Orbit/**/*.apk
          if-no-files-found: warn
